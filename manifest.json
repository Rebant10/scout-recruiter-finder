{
  "manifest_version": 3,
  "name": "Scout — Recruiter Finder",
  "short_name": "Scout",
  "version": "2.2.0",
  "description": "Type a company, get its recruiters' work emails, and keep them in a sheet. Uses your own Hunter.io or Apollo.io API key.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.hunter.io/*",
    "https://api.apollo.io/*",
    "https://autocomplete.clearbit.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_popup": "app/popup.html",
    "default_title": "Find recruiters",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "app/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
